@using MQTTnet
@using ProjectFishWorksWebApp.Models
@using ProjectFishWorksWebApp.Models.DeviceModels
@using ApexCharts
@using ProjectFishWorksWebApp.Services   <!-- bring in DeviceInit -->

@inject MQTTnet.ClientLib.MqttService MqttService

<MudGrid>
    <MudItem xs="6">
        <MudCard>
            <MudCardContent>
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h4">Outlet #1</MudText>
                    <MudSwitch Size="MudBlazor.Size.Large"
                               @bind-Value="aCControlDevice.Relay1Control"
                               Color="MudBlazor.Color.Success"
                               UncheckedColor="MudBlazor.Color.Error"
                               Disabled="@aCControlDevice.RelayOneInAlert" />
                    <MudChip T="string" Color="@(aCControlDevice.RelayOneInAlert ? MudBlazor.Color.Error : MudBlazor.Color.Success)">
                        @(aCControlDevice.RelayOneInAlert ? "Alert!" : "No Alert")
                    </MudChip>
                    <MudSelect Label="Select Alert Trigger Device" @bind-Value="aCControlDevice.RelayOneAlertNode">
                        <MudSelectItem Value="255">None</MudSelectItem>
                        @foreach (var node in Nodes)
                        {
                            <MudSelectItem Value="@node.Key">@node.Value</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch @bind-Value="aCControlDevice.RelayOneAlertInvert"
                               Color="MudBlazor.Color.Success"
                               UncheckedColor="MudBlazor.Color.Error">
                        @(aCControlDevice.RelayOneAlertInvert ? "Relay #1 will turn ON during alert" : "Relay #1 will turn OFF during alert")
                    </MudSwitch>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="6">
        <MudCard>
            <MudCardContent>
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h4">Outlet #2</MudText>
                    <MudSwitch Size="MudBlazor.Size.Large"
                               @bind-Value="aCControlDevice.Relay2Control"
                               Color="MudBlazor.Color.Success"
                               UncheckedColor="MudBlazor.Color.Error"
                               Disabled="@aCControlDevice.RelayTwoInAlert" />
                    <MudChip T="string" Color="@(aCControlDevice.RelayTwoInAlert ? MudBlazor.Color.Error : MudBlazor.Color.Success)">
                        @(aCControlDevice.RelayTwoInAlert ? "Alert!" : "No Alert")
                    </MudChip>
                    <MudSelect Label="Select Alert Trigger Device" @bind-Value="aCControlDevice.RelayTwoAlertNode">
                        <MudSelectItem Value="255">None</MudSelectItem>
                        @foreach (var node in Nodes)
                        {
                            <MudSelectItem Value="@node.Key">@node.Value</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch @bind-Value="aCControlDevice.RelayTwoAlertInvert"
                               Color="MudBlazor.Color.Success"
                               UncheckedColor="MudBlazor.Color.Error">
                        @(aCControlDevice.RelayTwoAlertInvert ? "Relay #2 will turn ON during alert" : "Relay #2 will turn OFF during alert")
                    </MudSwitch>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public int systemID { get; set; } = 0;
    [Parameter] public int basestationID { get; set; } = 0;
    [Parameter] public int nodeID { get; set; } = 0;

    [CascadingParameter] private Task<AuthenticationState>? authenticationState { get; set; }

    private ACControlDevice aCControlDevice;
    private BaseStationManifests baseStationManifests;

    private Dictionary<int, string> Nodes
    {
        get
        {
            var nodes = new Dictionary<int, string>();
            if (baseStationManifests == null) return nodes;

            var devices = baseStationManifests.Manifests.Find(x => x.BaseStationID == basestationID)?.Devices ?? new();
            foreach (var device in devices)
                nodes[device.NodeID] = device.DeviceName;

            return nodes;
        }
    }

    protected override Task OnInitializedAsync()
    {
        // Centralized client ID resolution
        var clientId = DeviceInit.ResolveClientId(authenticationState);

        aCControlDevice = new ACControlDevice(MqttService, clientId, systemID, basestationID, nodeID);
        baseStationManifests = new BaseStationManifests(clientId, systemID, MqttService);

        if (MqttService.IsConnected())
            MqttService.MessageReceived += MqttClient_MessageReceived;

        return Task.CompletedTask;
    }

    private void MqttClient_MessageReceived(object sender, MqttApplicationMessageReceivedEventArgs _)
    {
        StateHasChanged();
    }

    private MudBlazor.Color getCurrentBarColor(float? current) =>
        current == null || current < 10 ? MudBlazor.Color.Success : MudBlazor.Color.Error;

    private MudBlazor.Color getWattageBarColor(float? wattage) =>
        wattage == null || wattage < 1200 ? MudBlazor.Color.Success : MudBlazor.Color.Error;
}

