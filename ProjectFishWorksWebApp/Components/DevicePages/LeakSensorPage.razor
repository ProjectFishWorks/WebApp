@using MQTTnet
@using ProjectFishWorksWebApp.Models.DeviceModels
@using ProjectFishWorksWebApp.Services   <!-- bring in DeviceInit -->
@inject MQTTnet.ClientLib.MqttService MqttService

<MudGrid>
    <!-- Leak sensors -->
    <MudItem xs="6">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">Leak #1</MudText>
            <MudNumericField @bind-Value="leakSensorDevice.LeakSensor1Sensitivity"
                             Label="Sensor 1 Sensitivity"
                             Variant="Variant.Outlined" Min="0" Max="100" />
            <MudProgressLinear Value="leakSensorDevice.LeakSensor1Sensitivity"
                               Color="MudBlazor.Color.Warning"
                               Rounded="true" Style="height:10px;" />
            <MudChip T="string" Color="@(leakSensorDevice.Leak1Detected ? MudBlazor.Color.Error : MudBlazor.Color.Success)">
                @(leakSensorDevice.Leak1Detected ? "Leak Detected" : "No Leak Detected")
            </MudChip>
        </MudStack>
    </MudItem>
    <!-- Repeat for Leak #2, #3, #4 ... -->
</MudGrid>

<MudCard>
    <MudCardHeader>
        <MudText Typo="Typo.h4">Water Level Sensors</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="6">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">Water Level #1</MudText>
                    <MudChip T="string" Color="@(leakSensorDevice.HighWaterLevel1 ? MudBlazor.Color.Error : MudBlazor.Color.Success)">
                        @(leakSensorDevice.HighWaterLevel1 ? "High" : "Normal")
                    </MudChip>
                </MudStack>
            </MudItem>
            <!-- Repeat for Water Level #2, #3, #4 ... -->
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public int SystemID { get; set; }
    [Parameter] public int BaseStationID { get; set; }
    [Parameter] public int NodeID { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? authenticationState { get; set; }

    private LeakSensorDevice leakSensorDevice;

    protected override Task OnInitializedAsync()
    {
        // Centralized client ID resolution
        var userId = DeviceInit.ResolveClientId(authenticationState);
        leakSensorDevice = new LeakSensorDevice(MqttService, userId, SystemID, BaseStationID, NodeID);

        if (MqttService.IsConnected())
            MqttService.MessageReceived += MqttClient_MessageReceived;

        return Task.CompletedTask;
    }

    private void MqttClient_MessageReceived(object sender, MqttApplicationMessageReceivedEventArgs _)
    {
        StateHasChanged();
    }
}

