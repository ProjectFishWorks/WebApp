@using MQTTnet
@using ProjectFishWorksWebApp.Models
@using ProjectFishWorksWebApp.Models.DeviceModels
@using ProjectFishWorksWebApp.Services   <!-- bring in DeviceInit -->
@inject MQTTnet.ClientLib.MqttService MqttService

<MudGrid>
    <MudItem xs="6">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">Air Temp</MudText>
            <MudProgressLinear Value="(double)terrariumSensors.Temp"
                               Min="18"
                               Max="28"
                               Style="height:40px"
                               Color="@(getBarColor(20, 25, terrariumSensors.Temp))">
                <MudText Typo="Typo.h4"><b>@terrariumSensors.Temp °C</b></MudText>
            </MudProgressLinear>

            <MudText Typo="Typo.h6">Air Hum</MudText>
            <MudProgressLinear Value="(double)terrariumSensors.Humidity"
                               Min="0"
                               Max="100"
                               Style="height:40px"
                               Color="@(getBarColor(70, 101, terrariumSensors.Humidity))">
                <MudText Typo="Typo.h4"><b>@terrariumSensors.Humidity %</b></MudText>
            </MudProgressLinear>
        </MudStack>
    </MudItem>
    <MudItem xs="6">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">Soil Temp</MudText>
            <MudProgressLinear Value="(double)terrariumSensors.SoilTemp"
                               Min="18"
                               Max="28"
                               Style="height:40px"
                               Color="@(getBarColor(20, 25, terrariumSensors.SoilTemp))">
                <MudText Typo="Typo.h4"><b>@terrariumSensors.SoilTemp °C</b></MudText>
            </MudProgressLinear>

            <MudText Typo="Typo.h6">Soil Moisture</MudText>
            <MudProgressLinear Value="(double)terrariumSensors.SoilMoisture"
                               Min="0"
                               Max="3300"
                               Style="height:40px"
                               Color="@(getBarColor(1000, 2500, terrariumSensors.SoilMoisture))">
                <MudText Typo="Typo.h4"><b>@terrariumSensors.SoilMoisture mV</b></MudText>
            </MudProgressLinear>
        </MudStack>
    </MudItem>
</MudGrid>

<HistoryChart HistoryData="@terrariumSensors.TerrariumSensorsHistory"
              NodeID="@NodeID"
              MessageIDs="@historyMessageIDs"
              RequestData="terrariumSensorsChartRequestData"
              UpdateData="terrariumSensorsChartUpdateData"
              isFloatData="true"
              HistoryReceivedHours="terrariumSensors.HistoryReceivedHours" />

@code {
    [Parameter] public int SystemID { get; set; }
    [Parameter] public int BaseStationID { get; set; }
    [Parameter] public int NodeID { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? authenticationState { get; set; }

    private TerrariumSensorsDevice terrariumSensors;

    private Dictionary<int, HistoryChartMessageIDData> historyMessageIDs = new()
    {
        {2560, new HistoryChartMessageIDData{PerameterName = "Air Temperature", XAxisName = "Time", YAxisName = "Temperature °C"}},
        {2561, new HistoryChartMessageIDData{PerameterName = "Air Humidity", XAxisName = "Time", YAxisName = "Humidity %"}},
        {2562, new HistoryChartMessageIDData{PerameterName = "Soil Temperature", XAxisName = "Time", YAxisName = "Temperature °C"}},
        {2563, new HistoryChartMessageIDData{PerameterName = "Soil Moisture", XAxisName = "Time", YAxisName = "mV"}}
    };

    protected override Task OnInitializedAsync()
    {
        // Centralized client ID resolution
        var userId = DeviceInit.ResolveClientId(authenticationState);
        terrariumSensors = new TerrariumSensorsDevice(MqttService, userId, SystemID, BaseStationID, NodeID);

        if (MqttService.IsConnected())
            MqttService.MessageReceived += MqttClient_MessageReceived;

        return Task.CompletedTask;
    }

    private void MqttClient_MessageReceived(object sender, MqttApplicationMessageReceivedEventArgs e)
    {
        // Refresh the UI when a message is received
        if (int.Parse(e.ApplicationMessage.Topic.Split("/")[4]) == NodeID || e.ApplicationMessage.Topic.Split("/")[1] == "historyOut")
        {
            StateHasChanged();
        }
    }

    private MudBlazor.Color getBarColor(float? min, float? max, float? value)
    {
        if (min == null || max == null || value == null) return MudBlazor.Color.Success;
        if (value < min) return MudBlazor.Color.Info;
        if (value > max) return MudBlazor.Color.Error;
        return MudBlazor.Color.Success;
    }

    // Event handlers for the HistoryChart component
    private void terrariumSensorsChartRequestData(object sender, HistoryChartDataEventArgs e) =>
        terrariumSensors.requestHistoricalData(e.NodeID, e.MessageID, e.Hours);

    private void terrariumSensorsChartUpdateData(object sender, HistoryChartDataEventArgs e)
    {
        terrariumSensors.TerrariumSensorsHistory = terrariumSensors.updateHistoricalData(e.NodeID, e.MessageID, e.Hours);
        StateHasChanged(); // force a re-render
    }
}

Bottom of Page
